#!/usr/bin/env bash
# Inject using-toasttheory skill at every session start
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
SKILL_FILE="$PLUGIN_ROOT/skills/using-toasttheory/SKILL.md"

if [ ! -f "$SKILL_FILE" ]; then
  exit 0
fi

SKILL_CONTENT=$(cat "$SKILL_FILE")
ENCODED=$(printf '%s' "$SKILL_CONTENT" | python3 -c "import sys, json; print(json.dumps(sys.stdin.read()))")

printf '{"hookSpecificOutput":{"additionalContext":%s}}' "$ENCODED"
